# ========================================================
# DentaCollab Iraq - Environment Variables Template
# Copy this file to .env or apps/admin/.env.local and fill in your values
# DO NOT COMMIT ACTUAL API KEYS OR SERVICE ACCOUNTS TO GIT
# ========================================================

# Firebase Project Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Public Firebase Client Config (Admin Panel & Web)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Admin Panel Service Account Path (optional, relative or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Vite / Static App (Optional API Base)
VITE_API_BASE=
