rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserRole() {
      return isAuthenticated() && ('role' in request.auth.token) ? request.auth.token.role : 'student';
    }

    function isStaff() {
      return isAuthenticated() && getUserRole() in ['super_admin', 'academy_manager', 'content_editor', 'instructor', 'support_agent'];
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }

    function isAcademyManager() {
      return isAuthenticated() && getUserRole() in ['super_admin', 'academy_manager'];
    }

    function isContentEditor() {
      return isAuthenticated() && getUserRole() in ['super_admin', 'academy_manager', 'content_editor'];
    }

    function isSupportAgent() {
      return isAuthenticated() && getUserRole() in ['super_admin', 'academy_manager', 'support_agent'];
    }

    // Public / App Settings
    match /appSettings/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin() || isStaff();
    }

    match /heroBanners/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin() || isStaff();
    }

    match /privateSettings/{documentId} {
      allow read, write: if isSuperAdmin();
    }

    // User Profiles
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      // Students can create and update their personal profile info, but cannot set staff roles
      allow create: if isOwner(uid) 
        && !('role' in request.resource.data) 
        && request.resource.data.uid == uid;
      allow update: if isOwner(uid) 
        && !('role' in request.resource.data)
        && request.resource.data.uid == uid;
      allow delete: if isOwner(uid) || isSuperAdmin();

      // Notifications in subcollection
      match /notifications/{eventId} {
        allow read: if isOwner(uid);
        // Student can only mark 'read' as true/false, cannot alter other fields
        allow update: if isOwner(uid) 
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if isStaff();
      }

      // Saved courses
      match /savedCourses/{courseId} {
        allow read, write: if isOwner(uid);
      }

      // Notification preferences
      match /notificationPreferences/{prefId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Staff Memberships
    match /staffMemberships/{uid} {
      allow read: if isStaff() || isOwner(uid);
      allow write: if isSuperAdmin();
    }

    // Courses & Modules
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isContentEditor();

      match /modules/{moduleId} {
        allow read: if true;
        allow write: if isContentEditor();
      }
    }

    // Course Cohorts
    match /courseCohorts/{cohortId} {
      allow read: if true;
      allow write: if isAcademyManager();
    }

    // Workshops & Sessions
    match /workshops/{workshopId} {
      allow read: if true;
      allow write: if isContentEditor();
    }

    match /workshopSessions/{sessionId} {
      allow read: if true;
      allow write: if isAcademyManager();
    }

    // Instructors
    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isContentEditor();
    }

    // Enrollments (Mutations happen through Cloud Functions for atomic capacity check)
    match /enrollments/{enrollmentId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isStaff();
      allow write: if isStaff();
    }

    // Attendance records
    match /attendance/{attendanceId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isStaff();
      allow write: if isAcademyManager() || getUserRole() == 'instructor';
    }

    // Academy Services & Requests
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isContentEditor();
    }

    match /serviceRequests/{requestId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isStaff();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if (isAuthenticated() && resource.data.uid == request.auth.uid 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'preferredContactMethod', 'studentPhone']))
        || isStaff();
      allow delete: if isAcademyManager();
    }

    // Certificates & Public Verification
    match /certificates/{certificateId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isStaff();
      allow write: if isAcademyManager();
    }

    match /certificateVerification/{publicVerificationId} {
      allow read: if true; // Publicly verifiable with minimal non-PII details
      allow write: if isAcademyManager();
    }

    // Public Content: Gallery, Graduates, FAQs, Pages
    match /graduates/{gradId} {
      allow read: if true;
      allow write: if isContentEditor();
    }

    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    match /galleryAlbums/{albumId} {
      allow read, write: if true;
    }

    match /galleryMedia/{mediaId} {
      allow read, write: if true;
    }

    match /graduateReviews/{reviewId} {
      allow read: if true;
      allow write: if isContentEditor();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isContentEditor();
    }

    match /publicContent/{pageId} {
      allow read: if true;
      allow write: if isContentEditor();
    }

    // Support Tickets & Messages
    match /supportTickets/{ticketId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isSupportAgent();
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isSupportAgent() || (isAuthenticated() && resource.data.uid == request.auth.uid);

      match /messages/{messageId} {
        allow read: if (isAuthenticated() && get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid) || isSupportAgent();
        allow create: if isAuthenticated() && (request.resource.data.senderUid == request.auth.uid);
      }
    }

    // Device Registrations (Managed by Auth user or server)
    match /deviceRegistrations/{installationId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
    }

    // Notification campaigns & jobs
    match /notificationCampaigns/{campaignId} {
      allow read, write: if isAcademyManager();
    }

    match /notificationJobs/{jobId} {
      allow read, write: if isAcademyManager();
    }

    // Public broadcast notifications
    match /publicNotifications/{eventId} {
      allow read: if true;
      allow delete: if true;
      allow write: if isAcademyManager();
    }

    // Payments & Audits
    match /payments/{paymentId} {
      allow read: if (isAuthenticated() && resource.data.uid == request.auth.uid) || isAcademyManager();
      allow write: if isAcademyManager();
    }

    match /auditLogs/{eventId} {
      allow read: if isSuperAdmin();
      allow write: if false; // Server-only writes via Admin SDK
    }
  }
}
